# Copy to .env.local (never commit .env.local) and fill in.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gavelup?retryWrites=true&w=majority

# Public URL encoded in the registration QR code (no trailing slash).
# Leave empty locally — the current site origin is used.
PUBLIC_BASE_URL=

# Used once by `npm run seed` to create the first Game Master.
BOOTSTRAP_GM_NAME=Host One
BOOTSTRAP_GM_PIN=123456

# Game created by the seed script
GAME_CODE=GAVELUP26
GAME_NAME=Gavel Up 2026

# Local load testing only (all fake players share one IP). NEVER set this in production.
# DISABLE_RATE_LIMIT=1
